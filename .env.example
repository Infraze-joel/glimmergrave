# ---- Frontend (Netlify build environment / client/.env.local) ----
# OPTIONAL. Leave unset when hosting on Netlify (the backend then runs as a Netlify Server on the same origin, /ws).
# Set it only for an external backend. Must be wss:// in production (browsers block ws:// on https pages).
# VITE_SERVER_URL=wss://your-backend.example.com

# ---- Backend (server process environment) ----
# Port the game server listens on (most hosts inject PORT automatically).
PORT=8787
# Comma-separated list of allowed browser origins, e.g. https://your-site.netlify.app . "*" allows any origin.
ALLOWED_ORIGINS=*
# Maximum number of concurrent rooms on this instance.
MAX_ROOMS=200
